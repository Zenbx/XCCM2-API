// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" // Corrigé
  // Supprimez 'output' pour l'instant pour rester sur la config standard
}

datasource db {
  provider = "mongodb" // Corrigé (indispensable pour @db.ObjectId)
  url      = env("DATABASE_URL")
}

model User {
  // L'ID technique de MongoDB (indispensable)
  // On utilise @map("_id") car MongoDB exige un champ _id
  user_id String @id @default(auto()) @map("_id") @db.ObjectId

  // Champs d'identité
  email     String  @unique
  lastname  String
  firstname String
  password  String? // Sera stocké sous forme de hachage (bcrypt)

  // Informations professionnelles (optionnelles avec le "?")
  org             String?
  occupation      String?
  profile_picture String?
  role            String    @default("user")
  reset_token     String?
  reset_expires   DateTime?

  // Métadonnées recommandées pour le cycle de vie des données
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relation inverse : un utilisateur peut avoir plusieurs projets
  projects            Project[]
  receivedInvitations Invitation[] @relation("GuestInvitations")
  sentInvitations     Invitation[] @relation("HostInvitations")
  likes               Like[]
  views               View[]

  // Nouvelles relations pour les granules
  parts      Part[]
  chapters   Chapter[]
  paragraphs Paragraph[]
  notions    Notion[]
  comments   Comment[]

  // Templates créés par l'utilisateur
  templates        Template[]
  vaultItems       VaultItem[]
  marketplaceItems MarketplaceItem[]

  // Relations LMS
  teaching_classes  Classroom[]  @relation("ClassroomTeacher")
  enrollments       Enrollment[] @relation("StudentEnrollments")
  created_exercises Exercise[]   @relation("CreatedExercises")
  submissions       Submission[] @relation("StudentSubmissions")
  
  // Relations Devoirs et Annonces
  assignment_submissions AssignmentSubmission[]
  announcements          Announcement[]         @relation("AnnouncementAuthor")
  announcement_comments  AnnouncementComment[]
  notifications          Notification[]

  // Versioning
  created_revisions  ProjectRevision[] @relation("CreatedRevisions")
  granule_revisions  GranuleRevision[] @relation("GranuleRevisionAuthor")

  // Préférences et réglages (JSON flexible)
  settings Json?

  @@map("users") // Nom de la collection dans notre base MongoDB
}

model Project {
  pr_id      String   @id @default(auto()) @map("_id") @db.ObjectId
  pr_name    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 1. Définition du champ de la clé étrangère (doit être de type ObjectId)
  owner_id String @db.ObjectId

  // 2. Définition de la relation
  // fields: [owner_id] fait référence au champ ci-dessus
  // references: [user_id] fait référence à l'ID du modèle User
  owner User @relation(fields: [owner_id], references: [user_id])

  //A project has one or mores parts and generates one or more documents
  documents   Document[]
  parts       Part[]
  invitations Invitation[]
  comments    Comment[]

  // Course Metadata
  description  String?
  category     String?
  level        String?
  tags         String?
  author       String?
  language     String? @default("Français")
  is_published Boolean @default(false)

  // Course Styles (stored as JSON)
  styles Json?

  // LMS Relations
  classroom_links ClassroomProject[]

  // Versioning
  revisions         ProjectRevision[]
  granule_revisions GranuleRevision[]

  // 3. Contrainte d'unicité composée (name + owner_id)
  @@unique([pr_name, owner_id])
  @@index([owner_id])
  @@index([is_published])
  @@index([is_published, updated_at])
  @@map("projects")
}

model Comment {
  comment_id String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  author_id String @db.ObjectId
  author    User   @relation(fields: [author_id], references: [user_id])

  pr_id   String  @db.ObjectId
  project Project @relation(fields: [pr_id], references: [pr_id], onDelete: Cascade)

  @@map("comments")
}

model Document {
  doc_id       String   @id @default(auto()) @map("_id") @db.ObjectId
  doc_name     String // Le nom sera géré par le code au moment de l'insertion
  pages        Int // "Int" avec une majuscule
  doc_size     Int
  downloaded   Int      @default(0) // On initialise souvent à 0
  consult      Int      @default(0)
  published_at DateTime @default(now()) // "DateTime" avec majuscules
  url_content  String // "String" avec majuscule
  cover_image  String? // Image de couverture optionnelle

  // Clé étrangère
  pr_source String  @db.ObjectId //
  project   Project @relation(fields: [pr_source], references: [pr_id], onDelete: Cascade)

  //A document has zero, one or more likes
  likes Like[]
  views View[]

  // Contraintes d'unicités
  @@unique([doc_name, pr_source])
  @@index([pr_source])
  @@map("documents")
}

model Part {
  part_id     String  @id @default(auto()) @map("_id") @db.ObjectId
  part_title  String
  part_intro  String?
  part_ydoc   Bytes?
  part_number Int

  // Clé étrangère
  parent_pr String  @db.ObjectId
  project   Project @relation(fields: [parent_pr], references: [pr_id], onDelete: Cascade)

  owner_id String @db.ObjectId
  owner    User   @relation(fields: [owner_id], references: [user_id])

  //A part has one or more chapters

  chapters Chapter[]

  //Contraintes d'unicités
  @@unique([part_title, parent_pr])
  @@unique([part_number, parent_pr])
  @@index([parent_pr])
  @@index([owner_id])
  @@map("parts")
}

model Chapter {
  chapter_id     String  @id @default(auto()) @map("_id") @db.ObjectId
  chapter_title  String
  chapter_intro  String?
  chapter_ydoc   Bytes?
  chapter_number Int

  //Clé étrangère
  parent_part String @db.ObjectId
  part        Part   @relation(fields: [parent_part], references: [part_id], onDelete: Cascade)

  owner_id String @db.ObjectId
  owner    User   @relation(fields: [owner_id], references: [user_id])

  //A chapter has one or more paragraphs
  paragraphs Paragraph[]

  //Contraintes d'unicités
  @@unique([parent_part, chapter_title])
  @@unique([parent_part, chapter_number])
  @@index([parent_part])
  @@index([owner_id])
  @@map("chapters")
}

model Paragraph {
  para_id     String  @id @default(auto()) @map("_id") @db.ObjectId
  para_name   String
  para_intro  String?
  para_ydoc   Bytes?
  para_number Int

  //Clé étrangère
  parent_chapter String  @db.ObjectId
  chapter        Chapter @relation(fields: [parent_chapter], references: [chapter_id], onDelete: Cascade)

  owner_id String @db.ObjectId
  owner    User   @relation(fields: [owner_id], references: [user_id])

  //A paragraph has one or more notions
  notions Notion[]

  //Contraintes d'unicité
  @@unique([parent_chapter, para_name])
  @@unique([parent_chapter, para_number])
  @@index([parent_chapter])
  @@index([owner_id])
  @@map("paragraphs")
}

model Notion {
  notion_id      String @id @default(auto()) @map("_id") @db.ObjectId
  notion_name    String
  notion_number  Int
  notion_content String
  notion_ydoc    Bytes?

  //Clé étrangère
  parent_para String    @db.ObjectId
  paragraph   Paragraph @relation(fields: [parent_para], references: [para_id], onDelete: Cascade)

  owner_id String @db.ObjectId
  owner    User   @relation(fields: [owner_id], references: [user_id])

  // Historique collaboratif
  revisions GranuleRevision[]

  //Contraintes d'unicité
  @@unique([parent_para, notion_name])
  @@unique([parent_para, notion_number])
  @@index([parent_para])
  @@index([owner_id])
  @@map("notions")
}

// 1. Définition de l'énumération (Note: MongoDB supporte les enums via Prisma)
enum InvitationState {
  Pending
  Accepted
  Rejected
}

enum InvitationRole {
  EDITOR
  VIEWER
}

model Invitation {
  // Prisma a besoin d'un ID technique pour MongoDB même pour les tables de liaison
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Clés étrangères physiques
  pr_id    String @db.ObjectId
  guest_id String @db.ObjectId
  host_id  String @db.ObjectId

  // Champs de données
  invitation_state InvitationState @default(Pending)
  role             InvitationRole  @default(EDITOR)
  invitation_token String          @unique

  invited_at  DateTime  @default(now())
  response_at DateTime? // Optionnel tant qu'il n'a pas répondu

  // Relations
  project Project @relation(fields: [pr_id], references: [pr_id], onDelete: Cascade)
  guest   User    @relation("GuestInvitations", fields: [guest_id], references: [user_id], onDelete: Cascade)
  host    User    @relation("HostInvitations", fields: [host_id], references: [user_id], onDelete: Cascade)

  // CLÉ PRIMAIRE COMPOSITE (Logique)
  // Empêche d'inviter deux fois le même user au même projet
  @@unique([pr_id, guest_id])
  @@index([pr_id])
  @@index([guest_id])
  @@index([host_id])
  @@map("invitations")
}

model Like {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Clés étrangères physiques
  liker_id String @db.ObjectId
  doc_id   String @db.ObjectId

  like_at DateTime @default(now())

  // Relations
  liker    User     @relation(fields: [liker_id], references: [user_id])
  document Document @relation(fields: [doc_id], references: [doc_id], onDelete: Cascade)

  // CLÉ PRIMAIRE COMPOSITE (Logique)
  // Garantit qu'un utilisateur ne peut liker un document qu'une seule fois
  @@unique([liker_id, doc_id])
  @@index([liker_id])
  @@index([doc_id])
  @@map("likes")
}

model View {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  viewer_id String   @db.ObjectId
  doc_id    String   @db.ObjectId
  viewed_at DateTime @default(now())

  viewer   User     @relation(fields: [viewer_id], references: [user_id])
  document Document @relation(fields: [doc_id], references: [doc_id], onDelete: Cascade)

  // Unique constraint ensures one view per user per document
  @@unique([viewer_id, doc_id])
  @@index([viewer_id])
  @@index([doc_id])
  @@map("views")
}

model Template {
  template_id   String   @id @default(auto()) @map("_id") @db.ObjectId
  template_name String   @unique
  description   String?
  category      String?
  is_public     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Structure du template stockée en JSON
  // Contient la hiérarchie complète: Parts -> Chapters -> Paragraphs -> Notions
  structure Json

  // Créateur du template
  creator_id String @db.ObjectId
  creator    User   @relation(fields: [creator_id], references: [user_id])

  // Métadonnées
  usage_count Int @default(0) // Nombre de fois utilisé
  @@index([creator_id])
  @@map("templates")
}

model VaultItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  type            String // img, video, text, pdf, audio, part, chapter, paragraph, notion
  title           String
  content         String?
  file_url        String?
  original_id     String // ID technique de l'objet source
  source_doc_id   String?  @db.ObjectId
  source_doc_name String?
  added_at        DateTime @default(now())

  owner_id String @db.ObjectId
  owner    User   @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)
  @@index([owner_id])
  @@map("vault_items")
}

model MarketplaceItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  type         String // part, chapter, paragraph, notion
  title        String
  description  String?
  price        Float    @default(0) // Prix en euros (0 = gratuit)
  content      String? // Contenu ou structure JSON
  tags         String[] // Tags pour la recherche
  category     String?
  downloads    Int      @default(0)
  rating       Float? // Note moyenne sur 5
  published_at DateTime @default(now())

  seller_id String @db.ObjectId
  seller    User   @relation(fields: [seller_id], references: [user_id], onDelete: Cascade)
  @@index([seller_id])
  @@index([published_at])
  @@index([type, published_at])
  @@map("marketplace_items")
}

// --- NOUVEAUX MODELES LMS ---

model Classroom {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  join_code   String   @unique // Code court pour rejoindre, ex: A7B9F1
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  teacher_id String @db.ObjectId
  teacher    User   @relation("ClassroomTeacher", fields: [teacher_id], references: [user_id])

  enrollments   Enrollment[]
  projects      ClassroomProject[]
  assignments   Assignment[]
  announcements Announcement[]
  @@index([teacher_id])
  @@map("classrooms")
}

model Enrollment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  enrolled_at DateTime @default(now())

  // Relations
  student_id String @db.ObjectId
  student    User   @relation("StudentEnrollments", fields: [student_id], references: [user_id], onDelete: Cascade)

  classroom_id String    @db.ObjectId
  classroom    Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@unique([student_id, classroom_id])
  @@index([student_id])
  @@index([classroom_id])
  @@map("enrollments")
}

model ClassroomProject {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  added_at DateTime @default(now())
  doc_id   String?  @db.ObjectId // Reference to the published Document snapshot

  // Relations
  classroom_id String    @db.ObjectId
  classroom    Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  project_id String  @db.ObjectId
  project    Project @relation(fields: [project_id], references: [pr_id], onDelete: Cascade)

  @@unique([classroom_id, project_id])
  @@index([classroom_id])
  @@index([project_id])
  @@map("classroom_projects")
}

// --- NOUVEAUX MODELES DEVOIRS ET ANNONCES ---

model Assignment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  due_date        DateTime?
  type            String    @default("TEXT") // TEXT, FILE
  attachment_url  String?
  attachment_name String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  classroom_id String    @db.ObjectId
  classroom    Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  submissions  AssignmentSubmission[]

  @@index([classroom_id])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  content       String   // Texte ou URL Cloudinary
  score         Float?
  feedback      String?
  submitted_at  DateTime @default(now())

  assignment_id String     @db.ObjectId
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  student_id    String @db.ObjectId
  student       User   @relation(fields: [student_id], references: [user_id], onDelete: Cascade)

  @@unique([assignment_id, student_id])
  @@index([assignment_id])
  @@index([student_id])
  @@map("assignment_submissions")
}

model Announcement {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  content      String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  classroom_id String    @db.ObjectId
  classroom    Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  author_id    String @db.ObjectId
  author       User   @relation("AnnouncementAuthor", fields: [author_id], references: [user_id], onDelete: Cascade)

  comments     AnnouncementComment[]

  @@index([classroom_id])
  @@index([author_id])
  @@map("announcements")
}

model AnnouncementComment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  content         String
  created_at      DateTime @default(now())

  announcement_id String       @db.ObjectId
  announcement    Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  author_id       String @db.ObjectId
  author          User   @relation(fields: [author_id], references: [user_id], onDelete: Cascade)

  @@index([announcement_id])
  @@index([author_id])
  @@map("announcement_comments")
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  type       String   // NEW_ASSIGNMENT, COURSE_UPDATE, NEW_ANNOUNCEMENT
  message    String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user_id    String @db.ObjectId
  user       User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([user_id, is_read])
  @@index([user_id, created_at])
  @@map("notifications")
}

enum ExerciseType {
  QCU
  QCM
  QRO
  QROA
  CODE
  FILL_BLANKS
}

model Exercise {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  type        ExerciseType
  title       String
  description String?
  parameters  Json // Structure flexible: questions, options, réponses
  settings    Json? // Paramètres: temps, bloquant, points
  order       Int          @default(0)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  // Relations polymorphiques (Attachement à l'un des granules)
  project_id String? @db.ObjectId
  part_id    String? @db.ObjectId
  chapter_id String? @db.ObjectId
  para_id    String? @db.ObjectId
  notion_id  String? @db.ObjectId

  // Créateur de l'exercice
  creator_id String @db.ObjectId
  creator    User   @relation("CreatedExercises", fields: [creator_id], references: [user_id])

  submissions Submission[]
  @@index([project_id])
  @@index([part_id])
  @@index([chapter_id])
  @@index([para_id])
  @@index([notion_id])
  @@index([creator_id])
  @@map("exercises")
}

model Submission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  answers      Json // Réponses soumises
  score        Float? // Note
  feedback     String? // Commentaire global
  submitted_at DateTime @default(now())

  // Relations
  student_id String @db.ObjectId
  student    User   @relation("StudentSubmissions", fields: [student_id], references: [user_id], onDelete: Cascade)

  exercise_id String   @db.ObjectId
  exercise    Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  @@index([student_id])
  @@index([exercise_id])
  @@map("submissions")
}

// --- VERSIONING / REVISIONS ---

// Suivi collaboratif des modifications par notion (git blame / git diff)
model GranuleRevision {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  content_before String   // HTML avant la modification
  content_after  String   // HTML après la modification
  created_at     DateTime @default(now())

  notion_id String @db.ObjectId
  notion    Notion @relation(fields: [notion_id], references: [notion_id], onDelete: Cascade)

  project_id String  @db.ObjectId
  project    Project @relation(fields: [project_id], references: [pr_id], onDelete: Cascade)

  author_id String @db.ObjectId
  author    User   @relation("GranuleRevisionAuthor", fields: [author_id], references: [user_id])

  @@index([notion_id])
  @@index([project_id])
  @@index([author_id])
  @@index([notion_id, created_at])
  @@map("granule_revisions")
}

model ProjectRevision {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String?  // Nom optionnel donné par l'auteur ex: "Avant refonte Partie 2"
  snapshot     Json     // Arbre complet: { project, structure (parts->chapters->paras->notions) }
  created_at   DateTime @default(now())

  // Clé étrangère vers le projet
  project_id String  @db.ObjectId
  project    Project @relation(fields: [project_id], references: [pr_id], onDelete: Cascade)

  // Créateur de la révision
  creator_id String @db.ObjectId
  creator    User   @relation("CreatedRevisions", fields: [creator_id], references: [user_id])

  @@index([project_id])
  @@index([creator_id])
  @@map("project_revisions")
}
