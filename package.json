{
  "name": "my-prisma-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen-swagger && next build",
    "gen-swagger": "node scripts/generate-swagger.mjs",
    "start": "next start",
    "lint": "eslint",
    "gen:certs": "node scripts/generate-certs.js",
    "dev:https": "npm run gen:certs && HTTPS=true SSL_CRT_FILE=certs/localhost.crt SSL_KEY_FILE=certs/localhost.key next dev -p 443",
    "synapse": "tsx src/synapse/server.ts",
    "synapse:check": "node scripts/check-synapse-env.js",
    "synapse:dev": "npm run synapse:check && npm run synapse",
    "test-synapse": "node synapse-standalone.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/google": "^3.0.58",
    "@ai-sdk/mistral": "^3.0.30",
    "@aws-sdk/client-s3": "^3.1076.0",
    "@babel/runtime-corejs3": "^7.28.6",
    "@fontsource/poppins": "^5.2.7",
    "@hocuspocus/server": "^3.4.3",
    "@hocuspocus/transformer": "^3.4.3",
    "@huggingface/inference": "^4.13.9",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium": "^133.0.0",
    "@tiptap/core": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@types/nodemailer": "^6.4.17",
    "ably": "^2.17.0",
    "ai": "^6.0.146",
    "bcryptjs": "^3.0.3",
    "cookies-next": "^6.1.1",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "https": "^1.0.0",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "next": "^15.1.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.7",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^24.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "uuid": "^13.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "nodemailer": "^7.0.7"
  }
}
