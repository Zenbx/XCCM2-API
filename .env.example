# =============================================================================
# XCCM2 API - Environment Variables Template
# =============================================================================

# Database (local datacenter: mongodb://user:pass@10.50.30.5:27017/xccm-db?authSource=admin&replicaSet=rs0)
DATABASE_URL="mongodb://localhost:27017/xccm-db?replicaSet=rs0"

# JWT — identique sur API et Synapse
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-required"
JWT_EXPIRES_IN="7d"
PLUGIN_API_SECRET="your-plugin-api-secret-minimum-32-characters"

NODE_ENV="development"
PORT=3001

ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3000"
SYNAPSE_PUBLIC_URL="ws://localhost:1234"

# Redis local (docker compose dans deploy/)
REDIS_URL="redis://:changeme@127.0.0.1:6379"
# ou REDIS_HOST=127.0.0.1 REDIS_PORT=6379 REDIS_PASSWORD=changeme

# MinIO local (docker compose dans deploy/)
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="xccm-minio"
MINIO_SECRET_KEY="changeme-minio-password"
MINIO_BUCKET_DOCUMENTS="xccm-documents"
MINIO_BUCKET_UPLOADS="xccm-uploads"
MINIO_PUBLIC_URL="http://localhost:9000"

# IA (cloud — Internet requis)
MISTRAL_API_KEY=""
HF_API_TOKEN=""
HUGGING_FACE_API_KEY=""

# Temps réel structure (cloud)
ABLY_API_KEY=""

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
FROM_EMAIL="Your App Name <your-email@gmail.com>"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-nextauth-secret-minimum-32-characters"

# OAuth (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/callback/google"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/callback/azure-ad"
