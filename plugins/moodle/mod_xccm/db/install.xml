<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/xccm/db" VERSION="20260523" COMMENT="Table principale de l'activité XCCM2">
  <TABLES>
    <TABLE NAME="xccm" COMMENT="Instance d'activité XCCM2 dans un cours Moodle">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"
               COMMENT="ID du cours Moodle"/>
        <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""
               COMMENT="Nom de l'activité (affiché dans le cours)"/>
        <FIELD NAME="intro"        TYPE="text" NOTNULL="false"
               COMMENT="Description / consignes (champ standard Moodle)"/>
        <FIELD NAME="introformat"  TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="project_name" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT=""
               COMMENT="Nom du projet XCCM2 à ouvrir ({user_id} sera remplacé en mode individuel)"/>
        <FIELD NAME="mode"         TYPE="char" LENGTH="20"  NOTNULL="true" DEFAULT="individual"
               COMMENT="individual | collaborative"/>
        <FIELD NAME="editor_height" TYPE="int" LENGTH="5"  NOTNULL="true" DEFAULT="700"
               COMMENT="Hauteur de l'iframe en pixels"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
